{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "functions": {
    "app/api/[transport]/route.ts": {
      "maxDuration": 800,
      "memory": 1024
    },
    "app/api/stripe/webhook/route.ts": {
      "maxDuration": 30
    },
    "app/api/health/route.ts": {
      "maxDuration": 10
    }
  },
  "crons": [
    {
      "path": "/api/health?warm=1",
      "schedule": "*/4 * * * *"
    }
  ]
}
