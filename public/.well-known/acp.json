{
  "protocol": {
    "name": "acp",
    "version": "2025-09-12"
  },
  "vendor": {
    "name": "Eveoy",
    "url": "https://eveoy.com",
    "contact": "support@eveoy.com"
  },
  "api_base_url": "https://mcp.eveoy.com",
  "transports": ["http", "mcp-streamable-http"],
  "capabilities": {
    "services": ["catalog", "checkout"],
    "currencies": ["USD"],
    "payment_methods": ["stripe_checkout_session"],
    "fulfillment": ["digital_visit_credit"]
  },
  "endpoints": {
    "catalog": "https://eveoy.com/directory",
    "pricing": "https://eveoy.com/pricing",
    "checkout_session_create": "https://mcp.eveoy.com/mcp",
    "human_checkout": "https://eveoy.com/order",
    "order_status": "https://mcp.eveoy.com/mcp"
  },
  "auth": {
    "type": "oauth2",
    "authorization_server": "https://eveoy.com/.well-known/oauth-authorization-server",
    "protected_resource": "https://eveoy.com/.well-known/oauth-protected-resource",
    "register_uri": "https://eveoy.com/auth"
  },
  "documentation": "https://eveoy.com/auth.md",
  "spec_url": "https://github.com/agentic-commerce-protocol/agentic-commerce-protocol"
}
