{
  "$schema": "https://modelcontextprotocol.io/schemas/draft/server-card.json",
  "serverInfo": {
    "name": "eveoy-mcp",
    "version": "1.0.1",
    "title": "Eveoy — Verified In-Store Foot Traffic",
    "vendor": "Eveoy, Inc.",
    "documentation": "https://www.eveoy.com",
    "icons": [
      { "src": "https://mcp.eveoy.com/icon-512.png", "sizes": "512x512", "mimeType": "image/png" }
    ]
  },
  "transport": {
    "type": "streamable-http",
    "endpoint": "https://mcp.eveoy.com/mcp"
  },
  "capabilities": {
    "tools": { "listChanged": true },
    "resources": { "listChanged": true },
    "prompts": { "listChanged": true }
  },
  "auth": {
    "type": "oauth2",
    "required": false,
    "protected_resource_metadata": "https://mcp.eveoy.com/.well-known/oauth-protected-resource",
    "description": "Read tools are anonymous. start_checkout requires sign-in; it returns a sign_in_url, and the protected-resource metadata points at eveoy.com's authorization server."
  }
}
