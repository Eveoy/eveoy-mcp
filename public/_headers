# Cloudflare static-asset headers. Open CORS on agent-discovery endpoints so any
# client can read them cross-origin (Lovable brief: "* for GET discovery endpoints").
/.well-known/*
  Access-Control-Allow-Origin: *
  X-Content-Type-Options: nosniff
# Extensionless RFC 9728 metadata file → force JSON content type.
/.well-known/oauth-protected-resource
  Content-Type: application/json; charset=utf-8
  Access-Control-Allow-Origin: *
# Advertise discovery endpoints via Link header on the server card too.
/.well-known/mcp/server-card.json
  Access-Control-Allow-Origin: *
  Link: </.well-known/oauth-protected-resource>; rel="oauth-protected-resource"; type="application/json", </mcp>; rel="service"; title="MCP Streamable HTTP endpoint"
/llms.txt
  Access-Control-Allow-Origin: *
/sitemap.xml
  Access-Control-Allow-Origin: *
/robots.txt
  Access-Control-Allow-Origin: *
