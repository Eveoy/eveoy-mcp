{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "eveoy-mcp",
  "main": "src/index.ts",
  "compatibility_date": "2026-06-22",
  "compatibility_flags": ["nodejs_compat"],

  "observability": { "enabled": true },

  // Static surface — landing, privacy, icons, .well-known, sitemap, dxt.
  // run_worker_first forces the Worker for the MCP + health paths; every
  // other path is served straight from the edge asset store.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": ["/", "/index.html", "/mcp", "/sse", "/sse/message", "/health", "/info.json", "/link/callback", "/link/finish"]
  },

  // McpAgent session state (SQLite-backed Durable Object). Mandatory for McpAgent.
  "durable_objects": {
    "bindings": [{ "name": "MCP_OBJECT", "class_name": "EveoyMCP" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["EveoyMCP"] }],

  // 15-min cache for the live eveoy.com fetch path (Phase 3). Eventually
  // consistent — correct for read caching, NOT used for rate counters.
  "kv_namespaces": [{ "binding": "CACHE", "id": "da0dc20e2dad4f01b94a2cad266d6d1a" }],

  // Per-identifier soft rate limit (GA binding). period is 10 or 60 only.
  // 60/min anonymous (Lovable brief). Phase 2 adds a higher authenticated tier.
  "ratelimits": [
    { "name": "MCP_LIMIT", "namespace_id": "1001", "simple": { "limit": 60, "period": 60 } }
  ],

  "vars": {
    "MCP_CANONICAL_HOST": "mcp.eveoy.com",
    "EVEOY_ORIGIN": "https://www.eveoy.com",
    "MCP_CLASSIFIER_STRICT": "0",
    "SUPABASE_URL": "https://ascyiwwrflizprjypxxr.supabase.co",
    "SITE_URL": "https://www.eveoy.com"
  },

  // Zone is live on Cloudflare → attach mcp.eveoy.com as a Custom Domain.
  // Requires a token with Zone:eveoy.com Workers Routes:Edit (+ DNS:Edit).
  "routes": [{ "pattern": "mcp.eveoy.com", "custom_domain": true }]

  // Secrets (wrangler secret put): IP_HASH_SALT, SUPABASE_ANON_KEY
  //   (anon key is publishable but stored as a secret per Lovable's guidance)
}
