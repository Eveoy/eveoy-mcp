# ─── Eveoy MCP Server: environment ──────────────────────────────────
# Copy to .env.local and fill in. NEVER commit secrets.

# === Canonical URLs ===
# The public URL of this MCP server. Used for RFC 8707 audience binding.
MCP_CANONICAL_URL=https://mcp.eveoy.com/api/mcp
MCP_CANONICAL_HOST=mcp.eveoy.com

# === Upstash Redis (sessions, cache, rate limits) ===
# Provision via Vercel Marketplace → Upstash → Redis
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# === IP hashing salt (rotate quarterly) ===
IP_HASH_SALT=

# === Kill switches (Phase 5) ===
# Comma-separated list of tool names to disable at runtime
MCP_DISABLE_TOOL=
# 1 = disable DCR endpoint
MCP_DISABLE_DCR=
# 1 = disable all write tools globally
MCP_READONLY=
# 1 = classifier hits fail the whole response instead of redacting
MCP_CLASSIFIER_STRICT=

# === Phase 2 — payments / leads (uncomment when wiring) ===
# STRIPE_RESTRICTED_KEY=         # rk_live_… scoped to checkout+price+product:read
# STRIPE_WEBHOOK_SECRET=          # whsec_…
# NEON_DATABASE_URL=              # postgres://… via Vercel Marketplace
# RESEND_API_KEY=                 # for brad@eycrowd.com notifications
# RESEND_FROM=mcp@eveoy.com
# RESEND_TO=brad@eycrowd.com

# === Phase 2 — OAuth (uncomment when wiring) ===
# OAUTH_ISSUER=                   # IdP issuer URL
# OAUTH_JWKS_URL=                 # JWKS endpoint for token verification
# OAUTH_AUDIENCE=https://mcp.eveoy.com/api/mcp

# === Phase 3 — RAG (uncomment when wiring) ===
# UPSTASH_VECTOR_REST_URL=
# UPSTASH_VECTOR_REST_TOKEN=
# AI_GATEWAY_API_KEY=             # Vercel AI Gateway

# === Logging / SIEM (Phase 5) ===
# SIEM_WEBHOOK_URL=
